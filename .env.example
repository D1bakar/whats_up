# Application
APP_NAME=WhatsApp Platform
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# Security (Phase 2+ — placeholders only, no real values)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15

# WhatsApp provider: mock (default) | meta
WHATSAPP_PROVIDER=mock

# Meta Cloud API — NOT YET CONFIGURED (placeholders only, no real values)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_API_VERSION=v21.0
META_WHATSAPP_API_BASE_URL=https://graph.facebook.com
META_WHATSAPP_REQUEST_TIMEOUT=30

# Webhook verification and signature
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=

# Outbound retry policy
WHATSAPP_OUTBOUND_MAX_RETRIES=3
WHATSAPP_OUTBOUND_RETRY_BASE_DELAY=1.0

# AI (Phase 5+ — placeholders only)
OPENAI_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
